# =============================================================================
# Healthcare Guidelines RAG Assistant: configuration reference
#
#   cp .env.example .env        (scripts/setup.* does this for you)
#
# Every key read by backend/app/core/config.py (Settings) is listed here, each
# with a comment. tests/unit/test_config.py fails if this file and Settings drift.
# Real environment variables override .env; .env overrides code defaults.
# Values below are SAFE LOCAL-DEV DEFAULTS. Never put real secrets in this file.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# Deployment environment: development | test | staging | production.
# "production" enables hard guards (strong JWT secret, no question logging).
APP_ENV=development
# Log verbosity: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
# Log renderer: console (human-readable) | json (structured, for log shipping).
LOG_FORMAT=console
# Log raw question text (and withheld candidate answers) in the qa.completed event.
# MUST be false in production (ADR-0009: possible PHI).
LOG_QUESTION_TEXT=true

# --- HTTP --------------------------------------------------------------------
# Interface and port the API binds to.
API_HOST=127.0.0.1
# TCP port for the FastAPI service.
API_PORT=8000
# Comma-separated browser origins allowed by CORS. "*" is rejected in production.
CORS_ALLOW_ORIGINS=http://localhost:5173
# Allow unauthenticated POST /qa (demo convenience; ADR-0008 defaults auth on in prod).
ALLOW_ANONYMOUS_QA=true
# Per-client rate limit for /qa, "<count>/<second|minute|hour|day>" (token bucket,
# per process). Raise it for load tests: a 429 is answered instantly and skews latency.
RATE_LIMIT_QA=60/minute

# --- Corpus, index and embeddings (SC1) ------------------------------------------
# Changing any value in this block changes index_version and forces a re-index.
# Guideline corpus directory (relative paths are resolved from the repo root).
CORPUS_DIR=corpus
# Directory holding the built index artifacts and manifest.json.
INDEX_DIR=artifacts/index
# Embedding dimensionality. The project brief fixes it at 256.
EMBEDDING_DIM=256
# Key for blake2b feature hashing (ADR-0003). Not a secret, but part of index identity.
EMBEDDING_HASH_SALT=hc-rag-v1
# Chunk size targets in tokens (heading-aware chunker; H2 is a hard boundary).
CHUNK_MIN_TOKENS=80
# Upper bound per chunk; a single oversized table or list item may exceed it.
CHUNK_MAX_TOKENS=160
# Share of CHUNK_MAX_TOKENS repeated as trailing-sentence overlap between chunks.
CHUNK_OVERLAP_RATIO=0.15

# --- Retrieval and generation (ADR-0004) -----------------------------------------
# top_k used when a request omits it.
RETRIEVAL_TOP_K_DEFAULT=5
# Server-side ceiling for top_k (API contract hard limit: 20).
RETRIEVAL_TOP_K_MAX=20
# Reciprocal Rank Fusion constant k (dense ⊕ BM25).
RRF_K=60
# Weight of each retriever's vote in RRF, 0–1 (plain RRF = 1 and 1). Phase 4 dev tuning:
# the hashed dense vector lowers P@5 at every weight, so it ranks nothing by default and
# is used for the validator's retrieval score (docs/evaluation-report.md §3).
RRF_WEIGHT_DENSE=0.0
# Weight of the BM25 vote in RRF (0–1).
RRF_WEIGHT_SPARSE=1.0
# Candidates fetched from EACH retriever before fusion (>= top_k).
RETRIEVAL_CANDIDATE_K=50
# Expand queries with the deterministic acronym/synonym map (IPC ↔ infection prevention and control).
QUERY_EXPANSION_ENABLED=true
# Abstain (below_retrieval_floor) when cosine(question, best evidence chunk) is below this.
# 0.15 from the Phase 3 probe (lowest in-scope question 0.18); tuned on the dev split in Phase 4.
RETRIEVAL_FLOOR=0.15
# Maximum sentences in an extractive answer.
ANSWER_MAX_SENTENCES=3
# MMR trade-off: 1.0 = pure relevance, lower = penalise sentences similar to ones already chosen.
ANSWER_MMR_LAMBDA=0.7
# Drop candidate sentences scoring below this fraction of the best sentence's score.
ANSWER_MIN_RELATIVE_SCORE=0.5
# Answer generator: extractive (deterministic, default) | llm (optional, needs OPENAI_*).
GENERATOR=extractive

# --- Validation and confidence (ADR-0002) ----------------------------------------
# status=validated requires confidence >= this AND the numeric gate. Brief default: 0.6.
CONFIDENCE_THRESHOLD=0.6
# Confidence weights (ADR-0002). They must sum to 1.0. Chosen on the Phase 4 dev pool with
# 5-fold cross-validation, τ held at 0.6 and coverage kept at ≥ 0.2 (evaluation report §4).
# Weight of token coverage (answer tokens found in the cited guideline text).
CONFIDENCE_WEIGHT_COVERAGE=0.20
# Weight of query support (IDF-weighted question key terms in the best cited chunk).
CONFIDENCE_WEIGHT_QUERY_SUPPORT=0.60
# Weight of the retrieval score: cosine(question, best cited chunk).
CONFIDENCE_WEIGHT_RETRIEVAL=0.20

# --- Optional LLM generator (off by default) ---------------------------------------
# API key for GENERATOR=llm. Leave empty to keep the system API-free (SC1).
OPENAI_API_KEY=
# Model name for GENERATOR=llm (verify against current provider docs before use).
OPENAI_MODEL=

# --- Persistence and auth (Phase 5) ------------------------------------------------
# Async SQLAlchemy URL. Empty = stateless mode: /qa works, auth and admin routes answer 503.
# Local default: a SQLite file (relative paths are anchored at the repo root). For the
# docker-compose PostgreSQL use: postgresql+asyncpg://rag:rag@localhost:5432/rag
# Run scripts/db-migrate.sh (or .ps1) after changing it; the API refuses an unmigrated DB.
DATABASE_URL=sqlite+aiosqlite:///artifacts/app.db
# Days to keep query_log rows before the retention purge (ADR-0009).
QUERY_LOG_RETENTION_DAYS=30
# HMAC key for JWTs (>= 32 characters). Dev value only; production rejects it and needs a
# random secret (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
JWT_SECRET=change-me-dev-only-not-for-production-use
# Access-token lifetime in minutes.
JWT_ACCESS_TTL_MINUTES=15
# Refresh-token lifetime in days.
JWT_REFRESH_TTL_DAYS=7
# Secure flag on the refresh-token cookie. Empty = automatic (on outside development/test).
AUTH_COOKIE_SECURE=
# Login attempts per client address (per pod), e.g. 10/minute.
LOGIN_RATE_LIMIT=10/minute
# Max /qa outcomes buffered for the query-log writer; beyond it rows are dropped and counted.
QUERY_LOG_QUEUE_SIZE=10000
# Minutes between in-process retention purges (query logs, expired refresh tokens).
RETENTION_PURGE_INTERVAL_MINUTES=60
# Seconds between checks for runtime-config and active-index changes made by other pods.
CONFIG_POLL_SECONDS=30
# Admin account created by scripts/seed.* (never by the API). Empty = seed refuses to run.
SEED_ADMIN_EMAIL=admin@example.org
# Password for SEED_ADMIN_EMAIL. Dev value only; change it before any shared deployment.
SEED_ADMIN_PASSWORD=change-me-admin

# --- Index versions (Phase 5) -------------------------------------------------------
# Where admin-triggered rebuilds and published versions live (one folder per version).
INDEX_STORE_DIR=artifacts/indexes
# POST /admin/index/rebuild. Empty = automatic (development/test only); never in production.
ALLOW_INDEX_REBUILD=

# --- Observability -----------------------------------------------------------------
# Expose Prometheus metrics at /metrics.
METRICS_ENABLED=true
# OTLP endpoint for traces (e.g. http://localhost:4318). Empty disables export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Frontend (read by Vite from this root file; must start with VITE_) -----------
# Origin of the API for the SPA, e.g. https://api.example.org. Empty = same origin, which is
# the default and recommended setup: the Vite proxy (dev) or nginx (Phase 8) forwards /api,
# so the httpOnly refresh cookie works without CORS. Paths already include /api/v1.
VITE_API_BASE_URL=
