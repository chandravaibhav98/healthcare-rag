# ---------------------------------------------- build & run artifacts --------
# Index artifacts are BUILT, never committed (SC1: rebuild must reproduce them).
artifacts/
backend/artifacts/
backend/index/
*.faiss
# Evaluation run outputs; the summary is committed under docs/ instead.
backend/evaluation/reports/*
!backend/evaluation/reports/.gitkeep

