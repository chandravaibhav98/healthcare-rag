{
  "name": "healthcare-rag-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Playwright functional E2E (Phase 7), recorded demo (Phase 11), browser accessibility audit (Phase 6) and k6 load script (Phase 7).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "playwright test --project=e2e",
    "test:headed": "playwright test --project=e2e --headed",
    "demo": "playwright test --project=demo --reporter=list",
    "typecheck": "tsc -p .",
    "report": "playwright show-report",
    "audit": "node audit/ui-audit.mjs",
    "install-browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "lighthouse": "13.6.0",
    "playwright-core": "1.65.1",
    "typescript": "6.0.3"
  }
}
