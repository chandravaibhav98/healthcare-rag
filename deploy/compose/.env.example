# Compose settings for deploy/compose/docker-compose.yml.
# scripts/docker-up.* copies this file to deploy/compose/.env (git-ignored) on first run
# and replaces every `generate` value with a random secret. Edit .env, not this file.

# --- secrets (generated) ------------------------------------------------------------
POSTGRES_PASSWORD=generate
JWT_SECRET=generate
# Password for the seeded admin (and, with --demo, reviewer@ and user@example.org).
SEED_ADMIN_PASSWORD=generate
GRAFANA_ADMIN_PASSWORD=generate

# --- images -------------------------------------------------------------------------
API_IMAGE=rag-api:local
WEB_IMAGE=rag-web:local
# docker-up tags the index image rag-index:<index_version> and writes it here.
INDEX_IMAGE=rag-index:build

# --- runtime ------------------------------------------------------------------------
WEB_PORT=8080
SEED_ADMIN_EMAIL=admin@example.org
# Production defaults. E2E and load tests from one host need more (scripts set them).
RATE_LIMIT_QA=60/minute
LOGIN_RATE_LIMIT=10/minute
ALLOW_ANONYMOUS_QA=true
LOG_LEVEL=INFO
