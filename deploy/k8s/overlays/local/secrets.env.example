# Template for overlays/local/secrets.env (git-ignored). scripts/k8s-up.* creates that
# file on first run with random values; edit it only to choose your own passwords.
POSTGRES_PASSWORD=generate
JWT_SECRET=generate
SEED_ADMIN_PASSWORD=generate
# DATABASE_URL is derived from POSTGRES_PASSWORD by k8s-up:
# postgresql+asyncpg://rag:<POSTGRES_PASSWORD>@postgres:5432/rag
DATABASE_URL=generate
